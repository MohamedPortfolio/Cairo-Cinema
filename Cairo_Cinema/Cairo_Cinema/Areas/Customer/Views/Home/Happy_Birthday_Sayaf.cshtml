
@{
    Layout = null;
    ViewData["Title"] = "Happy Birthday Siyaf";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>عيد ميلاد سعيد يا سياف ❤️</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Playfair+Display:wght@700;800&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            font-family: 'Cairo', sans-serif;
            background:
                radial-gradient(circle at 50% 35%, #29200e 0%, #111 42%, #050505 100%);
            color: white;
            overflow-x: hidden;
        }

        .background-glow {
            position: fixed;
            width: 450px;
            height: 450px;
            background: #d4a83f;
            filter: blur(180px);
            opacity: .13;
            border-radius: 50%;
            top: 10%;
            left: 50%;
            transform: translateX(-50%);
            pointer-events: none;
        }

        .stars {
            position: fixed;
            inset: 0;
            pointer-events: none;
            overflow: hidden;
        }

        .star {
            position: absolute;
            color: #f6d77a;
            opacity: .6;
            animation: twinkle 3s infinite ease-in-out;
        }

        @@keyframes twinkle {
            0%, 100% { opacity: .2; transform: scale(.8); }
            50% { opacity: 1; transform: scale(1.3); }
        }

        .page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 35px 18px;
            position: relative;
            z-index: 1;
        }

        .birthday-card {
            width: 100%;
            max-width: 760px;
            text-align: center;
            padding: 55px 35px;
            border: 1px solid rgba(224, 184, 91, .35);
            border-radius: 28px;
            background: linear-gradient(
                145deg,
                rgba(35, 31, 22, .94),
                rgba(12, 12, 12, .97)
            );
            box-shadow:
                0 0 60px rgba(212, 168, 63, .10),
                inset 0 0 35px rgba(212, 168, 63, .035);
            position: relative;
            overflow: hidden;
            animation: appear 1.2s ease both;
        }

        .birthday-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 12%;
            width: 76%;
            height: 2px;
            background: linear-gradient(90deg, transparent, #e9c46a, transparent);
        }

        @@keyframes appear {
            from { opacity: 0; transform: translateY(35px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .crown {
            font-size: 48px;
            margin-bottom: 12px;
            display: inline-block;
            animation: float 3s ease-in-out infinite;
            filter: drop-shadow(0 0 15px rgba(255, 207, 91, .5));
        }

        @@keyframes float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-12px); }
        }

        .small-title {
            color: #d8b766;
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 4px;
            margin-bottom: 20px;
        }

        .main-title {
            font-family: 'Playfair Display', 'Cairo', serif;
            font-size: clamp(42px, 8vw, 72px);
            font-weight: 800;
            background: linear-gradient(135deg, #fff3c4, #d8ae4f, #fff0b5);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            margin-bottom: 8px;
            line-height: 1.3;
        }

        .arabic-title {
            font-size: clamp(23px, 5vw, 34px);
            font-weight: 800;
            color: #fff;
            margin-bottom: 25px;
        }

        .divider {
            width: 120px;
            height: 1px;
            margin: 25px auto;
            background: linear-gradient(90deg, transparent, #d8b766, transparent);
        }

        .age-circle {
            width: 155px;
            height: 155px;
            margin: 30px auto;
            border: 2px solid #cba44d;
            border-radius: 50%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            box-shadow:
                0 0 25px rgba(212, 168, 63, .18),
                inset 0 0 25px rgba(212, 168, 63, .08);
            position: relative;
        }

        .age-circle::before {
            content: "";
            position: absolute;
            inset: 8px;
            border: 1px dashed rgba(230, 195, 112, .5);
            border-radius: 50%;
        }

        .age-number {
            font-family: 'Playfair Display', serif;
            font-size: 66px;
            font-weight: 800;
            color: #e8c66e;
            line-height: 1;
        }

        .age-label {
            color: #c8b98e;
            font-size: 15px;
            margin-top: 8px;
        }

        .message {
            font-size: clamp(17px, 3vw, 21px);
            line-height: 2.2;
            color: #e7e0d1;
            margin: 25px auto;
            max-width: 570px;
        }

        .brother-name {
            color: #edca76;
            font-size: clamp(25px, 5vw, 36px);
            font-weight: 900;
            text-shadow: 0 0 22px rgba(230, 190, 90, .25);
        }

        .heart {
            color: #e75b68;
            display: inline-block;
            animation: heartbeat 1.2s infinite;
        }

        @@keyframes heartbeat {
            0%, 100% { transform: scale(1); }
            20% { transform: scale(1.2); }
            40% { transform: scale(1); }
            60% { transform: scale(1.15); }
        }

        .wish {
            color: #bdb39b;
            font-size: 15px;
            margin-top: 25px;
            line-height: 2;
        }

        .celebrate-btn {
            margin-top: 32px;
            padding: 13px 32px;
            border: 1px solid #e4c16b;
            border-radius: 50px;
            background: linear-gradient(135deg, #f0d58b, #b78b35);
            color: #17120a;
            font-family: 'Cairo', sans-serif;
            font-size: 16px;
            font-weight: 800;
            cursor: pointer;
            transition: .3s;
            box-shadow: 0 5px 25px rgba(212, 168, 63, .2);
        }

        .celebrate-btn:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 35px rgba(212, 168, 63, .4);
        }

        .footer {
            margin-top: 35px;
            color: #766d59;
            font-size: 12px;
        }

        .floating-heart {
            position: fixed;
            bottom: -30px;
            color: #d9ad56;
            opacity: .5;
            pointer-events: none;
            animation: rise 9s linear infinite;
        }

        @@keyframes rise {
            0% { transform: translateY(0) rotate(0); opacity: 0; }
            15% { opacity: .5; }
            85% { opacity: .5; }
            100% { transform: translateY(-110vh) rotate(360deg); opacity: 0; }
        }

        @@media (max-width: 576px) {
            .birthday-card {
                padding: 42px 20px;
                border-radius: 22px;
            }

            .age-circle {
                width: 135px;
                height: 135px;
            }

            .age-number {
                font-size: 56px;
            }

            .small-title {
                letter-spacing: 2px;
                font-size: 12px;
            }
        }
    </style>
</head>

<body>

    <div class="background-glow"></div>
    <div class="stars" id="stars"></div>

    <main class="page">
        <section class="birthday-card">

            <div class="crown">👑</div>

            <div class="small-title">A SPECIAL DAY FOR A SPECIAL PERSON</div>

            <h1 class="main-title">Happy Birthday</h1>

            <h2 class="arabic-title">عيد ميلاد سعيد يا سياف</h2>

            <div class="divider"></div>

            <div class="age-circle">
                <span class="age-number">29</span>
                <span class="age-label">سنة من التميز</span>
            </div>

            <p class="message">
                عيد ميلادك الـ 29 🎂
                <br>
                كل عام وأنت بألف خير،
                <br>
                عقبال مئة سنة من السعادة والنجاح وتحقيق كل أمنياتك.
                <br>
                تستاهل كل الخير يا أغلى أخ في الكون.
            </p>

            <div class="brother-name">
                <span class="heart">❤</span>
                أحمد سياف
                <span class="heart">❤</span>
            </div>

            <div class="divider"></div>

            <p class="wish">
                أتمنى أن تكون سنتك الجديدة أجمل من كل السنوات الماضية،
                وأن يرافقك الفرح والنجاح في كل خطوة.
                <br>
                دمت أخًا وسندًا وفخرًا ❤️
            </p>

            <button class="celebrate-btn" onclick="celebrate()">
                🎉 اضغط للاحتفال 🎉
            </button>

            <div class="footer">
                MADE WITH LOVE ❤️
            </div>

        </section>
    </main>

    <!-- Confetti Online Library -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>

    <script>
        // Create stars
        const starsContainer = document.getElementById("stars");

        for (let i = 0; i < 65; i++) {
            const star = document.createElement("span");
            star.className = "star";
            star.innerHTML = "✦";
            star.style.left = Math.random() * 100 + "%";
            star.style.top = Math.random() * 100 + "%";
            star.style.fontSize = (Math.random() * 12 + 5) + "px";
            star.style.animationDelay = Math.random() * 3 + "s";
            starsContainer.appendChild(star);
        }

        // Floating hearts
        function createHeart() {
            const heart = document.createElement("div");
            heart.className = "floating-heart";
            heart.innerHTML = Math.random() > 0.5 ? "❤" : "✦";
            heart.style.left = Math.random() * 100 + "%";
            heart.style.fontSize = (Math.random() * 20 + 12) + "px";
            heart.style.animationDuration = (Math.random() * 5 + 7) + "s";

            document.body.appendChild(heart);

            setTimeout(() => heart.remove(), 12000);
        }

        setInterval(createHeart, 900);

        // Birthday celebration
        function celebrate() {
            if (typeof confetti !== "function") return;

            const duration = 3500;
            const end = Date.now() + duration;

            (function frame() {
                confetti({
                    particleCount: 5,
                    angle: 60,
                    spread: 65,
                    origin: { x: 0 },
                    colors: ['#e8c66e', '#ffffff', '#d89b39', '#ff6680']
                });

                confetti({
                    particleCount: 5,
                    angle: 120,
                    spread: 65,
                    origin: { x: 1 },
                    colors: ['#e8c66e', '#ffffff', '#d89b39', '#ff6680']
                });

                if (Date.now() < end) {
                    requestAnimationFrame(frame);
                }
            })();

            confetti({
                particleCount: 150,
                spread: 100,
                origin: { y: 0.6 },
                colors: ['#e8c66e', '#ffffff', '#d89b39', '#ff6680']
            });
        }

        // Initial celebration
        window.addEventListener("load", () => {
            setTimeout(celebrate, 900);
        });
    </script>

</body>
</html>
